ppend Variable to Class [ClassName]: this.newProp = 0;) Tj T* (Append Function to Class [ClassName]: newMethod\(\) { return this.newProp; }) Tj T* (Insert Into Array [arrayName]: "item",) Tj T* (Insert Into Object [objectName]: key: value,) Tj T* ET
